# Configuration for deploy.sh. Copy to deploy.env (git-ignored) and edit:
#
#   cp deploy.env.example deploy.env && ./deploy.sh all
#
# Every setting can also be exported in the environment or passed as a flag to
# the component scripts directly. Only the LLM_* block is required.

# ============================================================================
# Hermes Agent - the LLM it thinks with (any OpenAI-compatible endpoint)
# ============================================================================
# Base URL, normally ending in /v1. Examples:
#   https://api.openai.com/v1
#   https://openrouter.ai/api/v1
#   http://vllm.my-models.svc.cluster.local:8000/v1      (in-cluster vLLM)
LLM_BASE_URL=
# Model id exactly as the endpoint's /v1/models reports it.
LLM_MODEL=
# Prefer a file over putting the key in this file. Leave both empty to be
# prompted. Set LLM_NO_API_KEY=true for an endpoint that needs no key.
LLM_API_KEY_FILE=
#LLM_API_KEY=
#LLM_NO_API_KEY=true

# Hermes sends ~14k prompt tokens per turn: the model needs >= 32k context.
# Set this only if Hermes cannot read the window from the endpoint.
#LLM_CONTEXT_LENGTH=131072

# Endpoint behind a private CA? Supply the CA, or trust this cluster's ingress
# CA for an endpoint exposed on a Route with the default certificate.
#LLM_CA_FILE=/path/to/ca.pem
#LLM_TRUST_INGRESS_CA=true

# No model available yet? Deploy a fake one and test the whole chain with it.
# Overrides the LLM_* settings above.
#LLM_MOCK=true

# ============================================================================
# Hermes Agent - deployment
# ============================================================================
HERMES_NAMESPACE=hermes
#HERMES_STORAGE_CLASS=gp3-csi
# Publish Hermes' own API outside the cluster (Open WebUI doesn't need this).
#HERMES_EXPOSE_ROUTE=true

# ============================================================================
# Open WebUI
# ============================================================================
OPENWEBUI_NAMESPACE=open-webui
# Directory containing deploy-open-webui.sh (default: <workspace>/open-web-ui)
#OPENWEBUI_DIR=/home/you/workspace/open-web-ui
#OPENWEBUI_STORAGE_CLASS=gp3-csi
#OPENWEBUI_ROUTE_HOST=chat.apps.example.com

# Strongly recommended: create the admin account before the site goes public.
# Otherwise the first visitor to sign up becomes administrator.
#OPENWEBUI_ADMIN_EMAIL=admin@example.com
#OPENWEBUI_ADMIN_PASSWORD_FILE=/path/to/password-file
