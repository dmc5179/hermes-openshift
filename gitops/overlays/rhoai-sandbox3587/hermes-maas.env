# Cluster-specific inputs to mint-and-exec.sh, merged into the hermes-env
# ConfigMap. These sit here rather than in base/ for the same reason the gateway
# URL and model id do: they differ per cluster.

# Gateway base URL with NO /v1 suffix -- the mint endpoint is
# {MAAS_API_BASE}/maas-api/v1/api-keys, which is a different path from the
# inference base_url in config.yaml (that one does end in /v1).
MAAS_API_BASE=https://maas.apps.rhoai.sandbox3587.opentlc.com

# The MaaSSubscription to bind the key to. Required: a key does not bind to a
# subscription implicitly, and minting without one is not safe to assume.
#
# Hardcoded rather than resolved at runtime on purpose. Resolving it would mean
# granting this ServiceAccount RBAC to read MaaSSubscriptions cluster-wide,
# which is otherwise entirely unnecessary -- maas-api authorises through the
# subscription's owner.groups, not through Kubernetes RBAC. Paying for a
# cluster role just to look up a string we already know is a bad trade.
MAAS_SUBSCRIPTION=granite-4-tiny-gpu-default

# Long by design. The key is pinned into the process environment at exec time
# and cannot be refreshed in a running pod, so this must exceed the maximum pod
# lifetime, not the restart interval. See the header of mint-and-exec.sh.
MAAS_KEY_TTL=720h
