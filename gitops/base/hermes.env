# Non-secret environment for the Hermes container (ConfigMap hermes-env).
# Secrets live in hermes-maas-credentials, which is created out of band.

# Without this the gateway starts but binds no HTTP listener at all, so every
# probe fails and the pod sits in CrashLoopBackOff with no obvious cause. This is
# the single most important line in this file.
API_SERVER_ENABLED=true

# 8642 is the api_server default (DEFAULT_PORT in gateway/platforms/api_server.py).
# Set explicitly so the Service, probes and this value cannot drift apart.
API_SERVER_PORT=8642

# Bind all interfaces so kubelet probes and the Service can reach it. The image
# already defaults to this; stated here so it survives a base-image change.
API_SERVER_HOST=0.0.0.0

# State directory. Matches the PVC mount path and the image's own default.
HERMES_HOME=/opt/data

PYTHONUNBUFFERED=1
